# Copy this file to .env and fill in ONE option. Never commit .env (it holds your key).

# Option C - Google Gemini, free tier (key from aistudio.google.com)
OPENAI_API_KEY=
AYV_LLM=openai:gemini-3.8-flash
AYV_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Option A - Claude (paid): use these lines instead of the three above
# ANTHROPIC_API_KEY=
# AYV_LLM=anthropic:claude-sonnet-5-5

# Option B - Ollama on your own laptop (free): use these lines instead
# AYV_LLM=openai:qwen2.5:7b
# AYV_LLM_BASE_URL=http://localhost:11434/v1

# Later stages
# AYV_EMBEDDER=st:BAAI/bge-m3      (Stage 3, after installing requirements.txt)
# ADMIN_TOKEN=change-me            (Stage 5, API admin routes)